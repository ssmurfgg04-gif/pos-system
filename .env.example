# Copy to .env (or export directly). Everything white-label lives in the
# settings table (admin UI → Settings), not here.

PORT=3000
DB_DRIVER=sqlite
DB_PATH=pos.db
# POSTGRES_DSN=postgres://user:password@localhost:5432/pos
SEED_DEMO=false
# Keep false in real deployments: true re-seeds the demo admin/cashier/designer
# logins (admin/admin123 ...) that migration v13 deliberately purged. The
# in-browser demo on the download site seeds its own sandbox copy separately.
MDNS_ENABLED=true
GIN_MODE=release
