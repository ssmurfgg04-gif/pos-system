# (UTF-8 — the previous file was half UTF-16LE and git never matched those
# rules; fixed 2026-10-22 in the Batch A hardening. Patterns below keep the
# original intent with the correct artifact names.)

# local db + logs
/bin/
pos.db
pos.db-wal
pos.db-shm
*.log
node_modules/
frontend/node_modules/
frontend/dist/
!frontend/dist/.gitkeep
.env
frontend/.vite/
*.tar.gz

# built binary (name is `posapp`; `pos-app` kept for old checkouts)
posapp
pos-app

# desktop packaging output (binaries hosted on GitHub Releases)
/build/

# generated Windows resources (rebuilt by scripts/build_installer.py)
rsrc_windows_*.syso
/versioninfo.json

# runtime artifacts from local serve/test runs
backups/
pos-backup-*.db

# Supabase CLI local state (tracked: supabase/config.toml + functions/)
supabase/.temp/
supabase/.branches/
frontend/tsconfig.tsbuildinfo
downloads/ledgerpos-setup.nsi
posapp-smoke

# smoke-run artifacts (local serve in the repo root)
secret.key
shops.json
